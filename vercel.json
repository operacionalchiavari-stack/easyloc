{
  "installCommand": "echo \"funcoes da pasta api so usam o Node (sem dependencias)\"",
  "buildCommand": "",
  "regions": [
    "gru1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), fullscreen=(self), payment=(), usb=(), serial=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "api/_gas/**"
    }
  },
  "crons": [
    {
      "path": "/api/gs-cron?projeto=almoxarifado&fn=atualizarTetoGastosAutomatico",
      "schedule": "0 9 * * *"
    }
  ]
}
